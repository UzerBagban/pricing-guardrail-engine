# Pricing Guardrail Engine - Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pricing_guardrail
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pricing_guardrail
DB_USER=user
DB_PASSWORD=password

# ERP / Inventory System (COGS)
ERP_API_URL=https://api.your-erp.com
ERP_API_KEY=your-erp-api-key

# Shipping APIs
UPS_API_URL=https://onlinetools.ups.com
UPS_API_KEY=your-ups-api-key
FEDEX_API_URL=https://apis.fedex.com
FEDEX_API_KEY=your-fedex-api-key
DHL_API_URL=https://api-eu.dhl.com
DHL_API_KEY=your-dhl-api-key

# Payment Gateway (Fees)
STRIPE_API_KEY=sk_live_your-stripe-key
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret

# Amazon VRP Scraping
AMAZON_SCRAPER_API_KEY=your-amazon-scraper-key
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER  # US marketplace
VRP_SCRAPE_SCHEDULE=0 6 * * *  # Daily at 6 AM UTC

# Marketplace APIs (for price updates)
AMAZON_SP_API_CLIENT_ID=your-amazon-sp-api-client-id
AMAZON_SP_API_CLIENT_SECRET=your-amazon-sp-api-client-secret
EBAY_API_KEY=your-ebay-api-key
WALMART_API_KEY=your-walmart-api-key
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_STORE_URL=your-store.myshopify.com

# Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ML Model
ELASTICITY_MODEL_PATH=models/elasticity_model.pkl
MODEL_RETRAIN_SCHEDULE=0 2 * * 0  # Weekly on Sunday at 2 AM UTC

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pricing_guardrail.log

# Security
SECRET_KEY=your-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24